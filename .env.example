# Copy to .env locally. On Cloudflare Workers set server secrets via:
#   npm run secrets:cloudflare
# (Workers → recenze-ceny → Settings → Variables and Secrets)

# Supabase — CZ project (ref ueuhriesbkeoivcndzmx)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Must match VITE_SUPABASE_PROJECT_ID (used by npm run db:migrate)
SUPABASE_PROJECT_ID=

# For npm run db:migrate (Settings → Database → password)
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=aws-0-eu-central-1.pooler.supabase.com

HOOK_SECRET=

# CPA partners (same account keys, filtered by MARKET_GEO=CZ)
KMA_API_KEY=
KMA_SOURCE_ID=
CPAGETTI_API_TOKEN=
CPA_TL_API_KEY=
M1_TOP_API_KEY=
M1_TOP_WEBMASTER_ID=
# Smoke only (prod uses m1_landing_facts DB drain like Shakes):
# M1_TOP_LANDING_FACTS_LIVE=llm
# M1_TOP_LANDING_FACTS_LLM=1
# CPA.tl smoke only — prod uses cpa_tl_landing_facts DB drain
# CPA_TL_LANDING_FACTS_LIVE=llm
# CPA_TL_LANDING_FACTS_LLM=1
ADCOMBO_API_KEY=
SHAKES_API_KEY=
SHAKES_STREAM_CODE=

AI_GATEWAY_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# Product-image vision facts (OpenRouter). Phase 4: cron drain ON when ENABLED=1.
# Kill switch: IMAGE_FACTS_ENABLED=0. Smoke: scripts/smoke-image-facts*.ts|mjs
IMAGE_FACTS_ENABLED=1
IMAGE_FACTS_SMOKE=0
IMAGE_FACTS_MODEL=openrouter/free
IMAGE_FACTS_MAX_LLM_PER_DAY=70
IMAGE_FACTS_MAX_PAID_PER_DAY=8
IMAGE_FACTS_MAX_TOKENS_PER_DAY=150000
IMAGE_FACTS_MAX_LLM_PER_IMAGE=2

SITE_URL=https://recenze-ceny.cz
SITE_ORIGIN=https://recenze-ceny.cz

INDEXNOW_KEY=
# Google Indexing API — JSON service account key (one line). See scripts/run-indexers-backfill.mjs
# Also used for GSC URL Inspection (enable Search Console API in same GCP project).
GOOGLE_INDEXING_SA_JSON=
# Optional GSC property for URL Inspection (default: sc-domain:recenze-ceny.cz)
# GSC_SITE_URL=sc-domain:recenze-ceny.cz
# Google Analytics 4 — set before `npm run build` / deploy; enables gtag in __root layout
VITE_GA4_ID=

# Cloudflare — CZ account
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CZ_WORKERS_DEV_BASE=https://recenze-ceny.workers.dev

# UptimeRobot — local one-shot: node scripts/setup-uptimerobot.mjs (do not commit the key)
UPTIMEROBOT_API_KEY=
